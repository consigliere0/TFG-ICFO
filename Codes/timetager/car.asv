% =========================================================================
%%                     CAR / BRIGHTNESS
% =========================================================================
clear all; close all; format long g;

set(groot, 'defaultTextInterpreter',         'latex')
set(groot, 'defaultAxesTickLabelInterpreter','latex');
set(groot, 'defaultLegendInterpreter',       'latex');

tau = 400 * 1e-12; % coincidence window 400ps
data_path = '../../Tests/timetagger/wvg2/entr5';

% *************************
%           TE
% *************************
te_files = dir(fullfile(data_path, '*TE*.txt'));

% ARRAYS to hold data
raw_HH = []; raw_VV = []; raw_HV = []; raw_VH = []; % HH = CC1; HV = CC3
ch1 = []; ch2 = []; ch3 = []; ch4 = []; % single counts

% Load and process each file
for k = 1:length(te_files)
    file_path = fullfile(data_path, te_files(k).name);
    data = readmatrix(file_path, 'NumHeaderLines', 12);  % Read numeric data starting from line 13

    RM_Alice = data(1, 13); RM_Bob = data(1, 12)*2;

    % Single counts
    ch1 = [ch1, data(1, 3)]; %HA*
    ch2 = [ch2, data(1, 4)]; %VA
    ch3 = [ch3, data(1, 5)]; %HB*
    ch4 = [ch4, data(1, 6)]; %VB*

    % CC
    raw_HH = [raw_HH, data(1, 8)];
    raw_HV = [raw_HV, data(1, 10)];
    raw_VV = [raw_VV, data(1, 9)];
    raw_VH = [raw_VH, data(1, 11)];

    % Accidentals calculation
    acc_HH = ch1 .* ch3 * tau;
    acc_HV = ch1 .* ch4 * tau;
    acc_VV = ch2 .* ch4 * tau;
    acc_VH = ch2 .* ch3 * tau;


    % Real coincidences
    HH_te = raw_HH - acc_HH;
    HV_te = raw_HV - acc_HV;
    VV_te = raw_VV - acc_VV;
    VH_te = raw_VH - acc_VH;
end


% *************************
%           TM
% *************************
