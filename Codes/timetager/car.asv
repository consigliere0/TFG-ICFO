% *************************
%           BELL
% *************************
bell_files = dir(fullfile(data_path, '*bell*.txt'));

% ARRAYS to hold data
raw_HH = []; raw_VV = []; raw_HV = []; raw_VH = []; % HH = CC1; HV = CC3
ch1 = []; ch2 = []; ch3 = []; ch4 = []; % single counts

% Load and process each file
for k = 1:length(bell_files)
    file_path = fullfile(data_path, bell_files(k).name);
    data = readmatrix(file_path, 'NumHeaderLines', 12);  % Read numeric data starting from line 13

    RM_Alice = data(1, 13); RM_Bob = data(1, 12)*2;

    % Single counts
    ch1 = [ch1, data(1, 3)]; %HA*
    ch2 = [ch2, data(1, 4)]; %VA
    ch3 = [ch3, data(1, 5)]; %HB*
    ch4 = [ch4, data(1, 6)]; %VB*

    % CC
    raw_HH = [raw_HH, data(1, 8)];
    raw_HV = [raw_HV, data(1, 10)];
    raw_VV = [raw_VV, data(1, 9)];
    raw_VH = [raw_VH, data(1, 11)];

    % Accidentals calculation
    acc_HH = ch1 .* ch3 * tau;
    acc_HV = ch1 .* ch4 * tau;
    acc_VV = ch2 .* ch4 * tau;
    acc_VH = ch2 .* ch3 * tau;


    % Real coincidences
    HH_bell = raw_HH - acc_HH;
    HV_bell = raw_HV - acc_HV;
    VV_bell = raw_VV - acc_VV;
    VH_bell = raw_VH - acc_VH;
end



% Power arrays
TE_pow = 0:18;
TM_pow = 0:15;
bell_pow = 0:18;

figure(1)
plot(TE_pow, VV, 'o'); hold on; plot(TE_pow, HH, 'x'); hold on;
plot(TE_pow, HV, '*'); hold on; plot(TE_pow, VH, 'diamond');


%% Plot
subplot(1, 3, 1);
plot(TE_pow, HH, 'o');
title()
subplot(1,3,2);
